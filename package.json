{
  "name": "z-td",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://idiovoidi.github.io/Zombie_Tower_Defence-OS2/Z_TD",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "server": "node server.js",
    "test:server": "node test-server.js",
    "test:write": "node test-write-direct.js",
    "build": "npm run quality && tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "type-check": "tsc --noEmit",
    "dupcheck": "jscpd src --format \"typescript,javascript\" --gitignore --min-lines 8 --min-tokens 60 --reporters console",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:report": "depcruise src --config .dependency-cruiser.cjs --output-type html > dependency-report.html",
    "dev:debug": "vite --debug",
    "clean": "rimraf dist node_modules/.vite",
    "knip": "knip",
    "build:types": "tsc -p tsconfig.build.json",
    "api-extractor": "npm run build:types && api-extractor run --local",
    "api-extractor:ci": "npm run build:types && api-extractor run",
    "api-documenter": "api-documenter markdown -i temp -o docs/api",
    "eslint": "eslint src/**/*.ts",
    "eslint:fix": "eslint src/**/*.ts --fix",
    "quality": "biome check . && tsc --noEmit && eslint src/**/*.ts && depcruise src --config .dependency-cruiser.cjs",
    "quality:full": "npm run quality && npm run knip && npm run dupcheck"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mathjs": "^15.0.0",
    "pixi.js": "^8.8.1",
    "regression": "^2.0.1",
    "simple-statistics": "^7.8.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-documenter": "^7.30.5",
    "@microsoft/api-extractor": "^7.58.7",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.3.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "globals": "^17.6.0",
    "jscpd": "^4.0.9",
    "knip": "^6.10.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
